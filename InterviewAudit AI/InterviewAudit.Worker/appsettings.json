{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=InterviewAuditDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\InterviewAudit\\Logs\\log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Scheduler": {
    "IntervalSeconds": 30
  },
  "InterviewFilterSettings": {
    "EnableFilterMode": false,
    "InterviewName": "",
    "RecentDays": 2,
    "StopSchedulerAfterCompletion": true
  },
  "Storage": {
    "JdFolder": "Data/JD",
    "ReportsFolder": "Data/Reports",
    "StateFilePath": "Data/processed-meetings.json",
    "MockDataFolder": "Data/MockData"
  },
  "GraphSettings": {
    "UseMock": true,
    "TenantId": "b553c4ea-9255-4e9b-ab21-e65af26175cf",
    "ClientId": "e261d156-38a5-44d0-ad15-6c971818c19e",
    "ClientSecret": "YOUR_AZURE_CLIENT_SECRET",
    "BaseUrl": "https://graph.microsoft.com/v1.0",
    "EventsEndpoint": "/users/{0}/events?$orderby=createdDateTime desc&$count=true",
    "OnlineMeetingsEndpoint": "/users/{0}/onlineMeetings/{1}",
    "TranscriptsEndpoint": "/users/{0}/onlineMeetings/{1}/transcripts",
    "TokenScope": "https://graph.microsoft.com/.default",
    "OrganizerUserId": "876ab97f-5bf6-4162-9228-da10f1bc2d76",
    "OrganizerEmail": "Interview.net@neosofttech.com"
  },
  "ParserSettings": {
    "CandidatePatterns": [
      "Candidate\\s+Name\\s*:\\s*([^\\r\\n]+)",
      "Candidate\\s*:\\s*([^\\r\\n]+)",
      "Applicant\\s*:\\s*([^\\r\\n]+)"
    ],
    "InterviewerPatterns": [
      "Interviewer\\s*Name\\s*:\\s*([^\\r\\n]+)",
      "Interviewer\\s*:\\s*([^\\r\\n]+)",
      "Evaluator\\s*:\\s*([^\\r\\n]+)",
      "Panel\\s*Name\\s*:\\s*([^\\r\\n]+)"
    ],
    "JdPatterns": [
      "Job\\s+Description\\s*(?:[:\\-]+)?\\s*([\\s\\S]*?)(?=\\s*(?:GID|CID)\\s*:|\\z)",
      "JD\\s*(?:[:\\-]+)?\\s*([\\s\\S]*?)(?=\\s*(?:GID|CID)\\s*:|\\z)",
      "Position\\s*:\\s*([\\s\\S]*?)(?=\\s*(?:GID|CID)\\s*:|\\z)"
    ],
    "GroupIdPatterns": [
      "GID\\s*:\\s*([^\\r\\n]+)",
      "Group\\s*ID\\s*:\\s*([^\\r\\n]+)"
    ],
    "CandidateIdPatterns": [
      "CID\\s*:\\s*([^\\r\\n]+)",
      "Candidate\\s*ID\\s*:\\s*([^\\r\\n]+)"
    ]
  }
}



